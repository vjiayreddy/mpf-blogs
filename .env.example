AUTH_SECRET=generate-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=https://api.example.com/graphql
GRAPHQL_URL=https://api.example.com/graphql
# Server-only service token for /api/cron/publish and public SSR reads
# (when the GraphQL API requires auth even for published content).
# Never use a user JWT here. Not sent to the browser.
GRAPHQL_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CRON_SECRET=generate-a-cron-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
